{
  "name": "racochu",
  "version": "1.0.0",
  "description": "DDD-based NestJS CLI server for semantic content chunking before Mnemosyne MCP ingestion",
  "bin": {
    "racochu": "dist/src/main.js"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && mkdir -p dist/src/generated && cp -r src/generated/prisma dist/src/generated/prisma",
    "start": "node dist/src/main.js",
    "start:dev": "APP_CONFIG_PATH=dev.yaml nodemon",
    "start:prod": "node dist/src/main.js",
    "ts-node": "dotenvx run -- node -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.cjs",
    "test:e2e:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.cjs --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "bensyne:start": "docker compose -p rag-e2e-bensyne -f src/e2e/env-setup/docker-compose.bensyne.yml up -d --wait",
    "bensyne:stop": "docker compose -p rag-e2e-bensyne -f src/e2e/env-setup/docker-compose.bensyne.yml down -v",
    "bensyne:logs": "docker compose -p rag-e2e-bensyne -f src/e2e/env-setup/docker-compose.bensyne.yml logs -f",
    "golden-query": "jest --config jest.e2e.config.cjs src/e2e/golden-query/golden-query.test.ts",
    "golden-query:unit": "jest --config jest.golden-query-unit.config.cjs",
    "tests:e2e": "nx run racochu:tests:e2e",
    "build:docker": "nx run racochu:build:docker",
    "start:docker": "nx run racochu:start:docker",
    "bump-version": "node scripts/bump-version.mjs --app apps/racochu"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.36",
    "@dotenvx/dotenvx": "2.20.1",
    "@eslint/js": "^10.0.1",
    "@mastra/rag": "2.4.2",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.221.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "chokidar": "5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "config": "5.0.0",
    "js-yaml": "5.2.3",
    "native-machine-id": "^0.3.11",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/testing": "11.1.28",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "latest",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prisma": "^7.9.1",
    "source-map-support": "0.5.21",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "overrides": {
    "@ai-sdk/openai": {
      "zod": "4.4.3"
    },
    "@ai-sdk/ui-utils-v5": {
      "zod": "4.4.3"
    },
    "@ai-sdk/provider-utils@2.2.8": {
      "zod": "4.4.3"
    },
    "zod-to-json-schema": {
      "zod": "4.4.3"
    }
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  }
}
