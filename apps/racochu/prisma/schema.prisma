generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Tracks a watched file and its ingestion metadata
model FileTracker {
  // Unique 64-bit integer identifier for the file tracker record (generated by application)
  id        BigInt         @id
  // Absolute file system path — unique constraint ensures one tracker per file
  filePath  String
  // Watch source identifier from Racochu config
  sourceId  String
  // Mnemosyne memory bank where this file's memories are stored
  memoryBank String
  // Record creation timestamp
  createdAt DateTime       @default(now())
  // Last modification timestamp
  updatedAt DateTime       @updatedAt

  // One-to-many relation to individual memories created from this file
  memories  FileMemoryTracker[]
  // SHA-256 hash of file content — nullable for backward compatibility
  fileHash  String?
  // Hardware ID of device that ingested this file — nullable for backward compatibility
  hardwareId String?

  @@unique([filePath])
  @@index([filePath])
  @@index([sourceId, memoryBank])
  @@index([fileHash])
  @@index([hardwareId])
}

// Links a file to a specific Mnemosyne memory ID — enables cleanup on file deletion
model FileMemoryTracker {
  // Unique 64-bit integer identifier for the file-memory mapping record (generated by application)
  id              BigInt      @id
  // External Mnemosyne memory ID (returned by remember operation)
  memoryId        String
  // Foreign key to the parent file tracker (64-bit integer)
  fileTrackerId   BigInt
  // Parent file tracker — cascade delete removes all memories when file is deleted
  fileTracker     FileTracker @relation(fields: [fileTrackerId], references: [id], onDelete: Cascade)
  // Mapping creation timestamp
  createdAt       DateTime    @default(now())

  // Prevents duplicate memory mappings for the same file
  @@unique([fileTrackerId, memoryId])
  @@index([fileTrackerId])
}
